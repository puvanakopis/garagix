# ============================================================
# Garagix Backend Environment Configuration (Template)
# Copy this file to .env and adjust values for your environment.
# ============================================================

# Server Configuration
PORT="5203"
ASPNETCORE_ENVIRONMENT="Development"

# Database Configuration (MySQL)
DB_HOST="localhost"
DB_PORT="3306"
DB_DATABASE="garagix_db"
DB_USERNAME="root"
DB_PASSWORD="your_mysql_password_here"
DATABASE_URL="Server=localhost;Port=3306;Database=garagix_db;User=root;Password=your_mysql_password_here;"

# JWT Authentication
JWT_SECRET="your_jwt_secret_key_min_32_characters_here"
JWT_ISSUER="GaragixApi"
JWT_AUDIENCE="GaragixFrontend"
JWT_EXPIRES_IN_HOURS="24"

# Frontend Origin for CORS
FRONTEND_URL="http://localhost:4200"
