# ============================================================
# Garagix Frontend Environment Configuration (Example Template)
# Copy to .env for local development: cp .env.example .env
# ============================================================

# Backend REST API Endpoint
NG_APP_API_URL=http://localhost:5203/api

# Application Metadata
NG_APP_NAME=Garagix Auto Care
NG_APP_TAGLINE=Precision Auto Care & Workshop Management
NG_APP_VERSION=1.0.0

# Environment Mode
NG_APP_ENV=development
NG_APP_PRODUCTION=false

# Support & Workshop Contact Information
NG_APP_SUPPORT_EMAIL=support@garagix.lk
NG_APP_SUPPORT_PHONE=+94 11 234 5678
NG_APP_WORKSHOP_ADDRESS=No. 45/A, Nawala Road, Nugegoda, Colombo, Sri Lanka

# Session & Storage Keys
NG_APP_STORAGE_PREFIX=garagix_
NG_APP_TOKEN_KEY=garagix_auth_token
NG_APP_USER_KEY=garagix_auth_user

