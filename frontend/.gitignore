# ==========================================
# Garagix Frontend Git Ignore Rules
# ==========================================

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out
/build

# Node & package managers
/node_modules
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Angular cache
/.angular/cache
.sass-cache/

# Environment files & credentials
.env
.env.*
!.env.example
*.local

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project
*.swp
*.swo

# Visual Studio Code
.vscode/
.history/*

# Miscellaneous & Testing
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings

# System files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
